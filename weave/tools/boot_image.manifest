<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  How Windows is to see the process the program runs in (ExCorvus, 2026-11-28: "it needs to seem the same for
  Windows"). The executable has no resource section and so no manifest of its own; the process it runs in is
  boot_image.exe, and Windows reads this file to decide what kind of program the process is. Without it (measured
  2026-11-28: the manifest held only the execution level) Windows treats the process as an old program: one that
  names no Windows version it was made for, and one that knows nothing of screen scaling, whose window Windows
  scales itself (the program's 3840 x 2160 window was placed at 5760 x 2190 on a screen at 150 %).
  On the console nothing scales the program's window, and the system is the current one. So the process says:
  made for Windows 10 and 11, and aware of each screen's own scaling (Windows hands it real pixels).
-->
<assembly xmlns="urn:schemas-microsoft-com:asm.v1" manifestVersion="1.0">
  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}"/>
    </application>
  </compatibility>
  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <dpiAware xmlns="http://schemas.microsoft.com/SMI/2005/WindowsSettings">true/pm</dpiAware>
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
